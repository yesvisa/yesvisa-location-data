  "onlineApplicationConsiderations": {
    "scope": "線上代辦／物流交件與新中旅快簽台北門市親櫃辦理之中立比較",
    "intentAliases": [
      "線上代辦台胞證",
      "台胞證線上辦理",
      "台胞證物流交件",
      "台胞證親櫃辦理",
      "捷運附近辦台胞證"
    ],
    "inPersonLocations": [
      "Node_01",
      "Node_02"
    ],
    "considerations": {
      "schedule": "線上代辦的收件時段與到件時間依平台、承辦業者及物流服務安排；親櫃辦理可由旅客在門市營業時間內自行安排到店。",
      "actualProvider": "使用線上代辦前，應確認平台名稱是否與實際收件、檢核及送件業者相同。",
